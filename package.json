{
  "name": "werigo-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "postbuild": "node scripts/sitemap-dates.mjs",
    "test:sitemap": "node scripts/sitemap-test.mjs && node scripts/sitemap-dates-test.mjs",
    "test:membership": "node scripts/ride-club-test.mjs",
    "test:cms": "node scripts/cms-test.mjs",
    "test:pricing": "node scripts/pricing-test.mjs && node scripts/monthly-daily-test.mjs",
    "test:rental": "node scripts/app-rental-flow-test.mjs",
    "test:booking-payment": "node --experimental-transform-types scripts/booking-payment-flow-test.mjs && node scripts/qa-snap-closure-test.mjs && node --experimental-transform-types scripts/fleet-availability-refresh-test.mjs",
    "build:ops-reverse-audit": "npm run build && node scripts/ops-reverse-live-audit.mjs",
    "build:booking-audit": "npm run build && node scripts/booking-live-audit.mjs audit",
    "build:booking-qa-cleanup": "npm run build && node scripts/booking-live-audit.mjs --release-qa WERIGO-QA-e3fab23d-268b-48c7-a501-4b8b7dffa60a",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:status": "node scripts/db-migrate.mjs --status",
    "auth:generate": "better-auth generate --config src/lib/auth.ts --output db/migrations/0002_auth.sql -y",
    "create-admin": "node scripts/create-admin.mjs",
    "test:articles": "node scripts/articles-test.mjs",
    "test:support": "node scripts/support-test.mjs",
    "build:ops-audit": "npm run build && node scripts/ops-maintenance.mjs audit",
    "build:ops-inspect": "npm run build && node scripts/ops-consolidate.mjs inspect",
    "build:ops-migrate": "npm run build && node scripts/ops-consolidate.mjs migrate",
    "build:ops-verify": "npm run build && node scripts/ops-consolidate.mjs verify",
    "test:ops": "node scripts/ops-consolidated-test.mjs && node scripts/ops-reverse-audit-test.mjs",
    "test:workspace": "node --experimental-transform-types scripts/workspace-access-test.mjs && node scripts/workspace-entry-test.mjs"
  },
  "dependencies": {
    "@tiptap/pm": "3.23.5",
    "@tiptap/react": "3.23.5",
    "@tiptap/starter-kit": "3.23.5",
    "better-auth": "^1.7.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.26.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.22",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "puppeteer-core": "^25.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@tiptap/core": "3.23.5",
    "@tiptap/extension-blockquote": "3.23.5",
    "@tiptap/extension-bold": "3.23.5",
    "@tiptap/extension-bubble-menu": "3.23.5",
    "@tiptap/extension-bullet-list": "3.23.5",
    "@tiptap/extension-code": "3.23.5",
    "@tiptap/extension-code-block": "3.23.5",
    "@tiptap/extension-document": "3.23.5",
    "@tiptap/extension-dropcursor": "3.23.5",
    "@tiptap/extension-floating-menu": "3.23.5",
    "@tiptap/extension-gapcursor": "3.23.5",
    "@tiptap/extension-hard-break": "3.23.5",
    "@tiptap/extension-heading": "3.23.5",
    "@tiptap/extension-horizontal-rule": "3.23.5",
    "@tiptap/extension-italic": "3.23.5",
    "@tiptap/extension-link": "3.23.5",
    "@tiptap/extension-list": "3.23.5",
    "@tiptap/extension-list-item": "3.23.5",
    "@tiptap/extension-list-keymap": "3.23.5",
    "@tiptap/extension-ordered-list": "3.23.5",
    "@tiptap/extension-paragraph": "3.23.5",
    "@tiptap/extension-strike": "3.23.5",
    "@tiptap/extension-text": "3.23.5",
    "@tiptap/extension-underline": "3.23.5",
    "@tiptap/extensions": "3.23.5",
    "@tiptap/pm": "3.23.5",
    "@tiptap/react": "3.23.5",
    "@tiptap/starter-kit": "3.23.5"
  }
}
