# Werigo environment configuration
# Copy to .env.local for local development. On Hostinger, set these in
# hPanel → your app → Environment variables. Never commit real values.
#
# Variables are grouped by the phase that first needs them:
#   Phase 0  database on the VPS, admin login, WhatsApp notifications
#   Phase 1  customer accounts, Midtrans payment, email

# ---------- Public (safe for the browser) ----------

# Booking mode: "database" stores every booking in PostgreSQL and
# (from Phase 1) takes payment; "whatsapp" sends requests straight to
# WhatsApp with no database calls.
NEXT_PUBLIC_BOOKING_MODE=database

# Canonical site URL, no trailing slash. Used for auth callbacks and
# links in notifications. http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=https://werigo.co

# NOTE: the WhatsApp number is fixed in src/lib/config.ts and no
# longer read from the environment. Remove NEXT_PUBLIC_WHATSAPP_NUMBER
# from the hosting environment if it is still set.

# [Phase 1] Midtrans Snap client key (SB-Mid-client-... in sandbox) and
# environment ("sandbox" or "production"; selects the Snap script URL).
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_ENV=sandbox

# ---------- Server-only (NEVER prefix these with NEXT_PUBLIC_) ----------

# [Phase 0] PostgreSQL on the VPS. TLS is always required by the app.
# Format: postgresql://USER:PASSWORD@db.werigo.co:5432/werigo
DATABASE_URL=

# [Phase 0] Auth secret for session cookies (32+ random bytes, e.g.
# `openssl rand -base64 32`). Changing it signs everyone out.
BETTER_AUTH_SECRET=

# [Phase 0] Fonnte WhatsApp notifications. Token from the Fonnte
# device dashboard; recipients in international format, digits only,
# comma separated (e.g. 628123456789,628987654321).
FONNTE_TOKEN=
ADMIN_WHATSAPP_NUMBERS=

# [Phase 0] Secret for the maintenance endpoints the VPS cron calls
# (retry notifications, expire unpaid bookings). Long random string.
CRON_SECRET=

# [Phase 1] Midtrans server key (SB-Mid-server-... in sandbox).
MIDTRANS_SERVER_KEY=

# [Phase 1] Google sign-in (Google Cloud Console → OAuth client, Web).
# Redirect URI: ${NEXT_PUBLIC_SITE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [Phase 1] Outgoing email (verification, password reset) via the
# Hostinger mailbox. Port 465 uses implicit TLS.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@werigo.co
SMTP_PASSWORD=
MAIL_FROM="Werigo <noreply@werigo.co>"

# WERIGO SAGA counters and comments folder (optional, default ~/.werigo-data).
# Keep it outside the app folder so deploys do not wipe it.
# SAGA_DATA_DIR=

# Secret for moderating saga comments (x-admin-key header). Use a long
# random string. Moderation is disabled while this is empty. See README.
SAGA_COMMENTS_ADMIN_KEY=

# ---------- Local testing only (do not set in production) ----------
# BOOKING_STORE=memory     # in-memory store for automated local tests
# ALLOW_MEMORY_STORE=1     # required to use the memory store with `next start`
# SIMULATE_DB_FAILURE=1    # makes the memory store fail, for failure-path tests
