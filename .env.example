# Werigo environment configuration
# Copy to .env.local for local development. On Hostinger, set these in
# hPanel → your app → Environment variables. Never commit real values.

# ---------- Public (safe for the browser) ----------

# Business WhatsApp number — international format, digits only (e.g. 6281234567890)
NEXT_PUBLIC_WHATSAPP_NUMBER=620000000000

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
# The server also accepts SUPABASE_URL, which takes priority.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key — used only for admin sign-in sessions.
# RLS denies all direct data access with this key.
# The server also accepts SUPABASE_PUBLISHABLE_KEY, which takes priority.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------- Server-only (NEVER prefix these with NEXT_PUBLIC_) ----------

# Supabase server key — full database access, server only. Use either:
#   SUPABASE_SECRET_KEY        the new secret key (sb_secret_...) — takes priority
#   SUPABASE_SERVICE_ROLE_KEY  the legacy service-role JWT
# Values are trimmed, but avoid pasting trailing spaces or newlines.
# A publishable key here is rejected at startup.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed into /admin/bookings,
# e.g. owner@werigo.co,ops@werigo.co
ADMIN_EMAILS=

# ---------- Local testing only (do not set in production) ----------
# BOOKING_STORE=memory     # in-memory store for automated local tests
# ALLOW_MEMORY_STORE=1     # required to use the memory store with `next start`
# SIMULATE_DB_FAILURE=1    # makes the memory store fail, for failure-path tests
